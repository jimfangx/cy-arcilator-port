# Record inputs at configure time, independently of the installed SDK files.
function(driver_json_quote input output)
  string(REPLACE "\\" "\\\\" escaped "${input}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\\n" escaped "${escaped}")
  string(REPLACE "\r" "\\r" escaped "${escaped}")
  string(REPLACE "\t" "\\t" escaped "${escaped}")
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

set(driver_config "{}")
string(JSON driver_config SET "${driver_config}" schema 1)
macro(driver_record_string key value)
  driver_json_quote("${value}" quoted_value)
  string(JSON driver_config SET "${driver_config}" "${key}" "${quoted_value}")
endmacro()
driver_record_string(phase configured)
driver_record_string(circt_revision fa4f662cbe710906347fac795c581a06c6b99757)
driver_record_string(llvm_revision a17069fea5b271c6824ea773874b007116de9644)
driver_record_string(source "${ARCILATOR_SOURCE}")
driver_record_string(source_sha256 "${driver_source_sha256}")
driver_record_string(source_variant "${driver_source_variant}")
driver_record_string(sdk "${CIRCT_SDK}")
driver_record_string(sdk_version "${driver_sdk_version}")
driver_record_string(compiler "${CMAKE_CXX_COMPILER}")
driver_record_string(compiler_id "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
driver_record_string(cxx_flags "${CMAKE_CXX_FLAGS}")
driver_record_string(release_cxx_flags "${CMAKE_CXX_FLAGS_RELEASE}")
driver_record_string(target_cxx_flags "-O3 -DNDEBUG -fno-rtti -fno-exceptions")
driver_record_string(build_type "${CMAKE_BUILD_TYPE}")
driver_record_string(cxx11_abi "${ARCILATOR_DRIVER_CXX11_ABI}")
foreach(feature JIT FST)
  if(ARCILATOR_DRIVER_ENABLE_${feature})
    string(JSON driver_config SET "${driver_config}" "enable_${feature}" true)
  else()
    string(JSON driver_config SET "${driver_config}" "enable_${feature}" false)
  endif()
endforeach()
foreach(reference bin/firtool bin/llvm-config include/llvm/Config/llvm-config.h)
  file(SHA256 "${CIRCT_SDK}/${reference}" reference_sha256)
  driver_record_string("sdk_sha256:${reference}" "${reference_sha256}")
endforeach()
foreach(project_file CMakeLists.txt Provenance.cmake RecordBuild.cmake)
  file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${project_file}" project_sha256)
  driver_record_string("project_sha256:${project_file}" "${project_sha256}")
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/arcilator-driver-config.json" "${driver_config}\n")
