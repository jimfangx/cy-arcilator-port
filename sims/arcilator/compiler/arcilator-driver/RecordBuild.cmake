# This runs only after the separately built driver has linked successfully.
foreach(required DRIVER_BINARY DRIVER_CONFIG DRIVER_RECORD)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(READ "${DRIVER_CONFIG}" record)
string(JSON source GET "${record}" source)
string(JSON expected_source_sha256 GET "${record}" source_sha256)
file(SHA256 "${source}" actual_source_sha256)
if(NOT actual_source_sha256 STREQUAL expected_source_sha256)
  message(FATAL_ERROR "Driver source changed after configuration")
endif()
file(SHA256 "${DRIVER_BINARY}" binary_sha256)
string(REPLACE "\\" "\\\\" escaped_binary "${DRIVER_BINARY}")
string(REPLACE "\"" "\\\"" escaped_binary "${escaped_binary}")
string(REPLACE "\n" "\\n" escaped_binary "${escaped_binary}")
string(REPLACE "\r" "\\r" escaped_binary "${escaped_binary}")
string(REPLACE "\t" "\\t" escaped_binary "${escaped_binary}")
string(JSON record SET "${record}" phase "\"built\"")
string(JSON record SET "${record}" binary "\"${escaped_binary}\"")
string(JSON record SET "${record}" binary_sha256 "\"${binary_sha256}\"")
file(WRITE "${DRIVER_RECORD}" "${record}\n")
