+//===- SourceOrderPrefix.h - Source-order ready prefix index -----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+// Private implementation helper: indexes only a queue's static source category.
+// No dynamic scheduling winner is retained across pops.
+#ifndef LLVM_PRIVATE_SOURCE_ORDER_PREFIX_H
+#define LLVM_PRIVATE_SOURCE_ORDER_PREFIX_H
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+
+namespace llvm {
+namespace source_order_detail {
+class PrefixIndex {
+  static constexpr unsigned Leaves = 1024;
+  std::array<uint64_t, 2 * Leaves> Keys{};
+  std::array<unsigned, 2 * Leaves> Counts{};
+  uint64_t Epoch = 0;
+  unsigned Size = 0;
+  bool Valid = false;
+
+  void set(unsigned I, uint64_t K) {
+    assert(I < Limit);
+    I += Leaves;
+    Keys[I] = K;
+    Counts[I] = K != 0;
+    while ((I /= 2) != 0) {
+      Keys[I] = std::max(Keys[2 * I], Keys[2 * I + 1]);
+      Counts[I] = (Keys[2 * I] == Keys[I] ? Counts[2 * I] : 0) +
+                  (Keys[2 * I + 1] == Keys[I] ? Counts[2 * I + 1] : 0);
+    }
+  }
+
+  template <class Fn> void visit(unsigned I, uint64_t K, Fn &F) const {
+    if (Keys[I] != K || !Counts[I])
+      return;
+    if (I >= Leaves) {
+      F(I - Leaves);
+      return;
+    }
+    visit(2 * I, K, F);
+    visit(2 * I + 1, K, F);
+  }
+
+public:
+  static constexpr unsigned Limit = 1000;
+  static uint64_t key(bool ScheduleLow, unsigned IROrder) {
+    return (uint64_t(ScheduleLow) << 33) |
+           (IROrder ? uint64_t(IROrder) : uint64_t(1) << 32);
+  }
+  void invalidate() { Valid = false; }
+
+  template <class Q, class Key> void prepare(const Q &Queue, uint64_t E, Key K) {
+    unsigned N = std::min<size_t>(Queue.size(), Limit);
+    if (Valid && Epoch == E && Size == N)
+      return;
+    Keys.fill(0);
+    Counts.fill(0);
+    for (unsigned I = 0; I < N; ++I) {
+      Keys[Leaves + I] = K(Queue[I]);
+      assert(Keys[Leaves + I] != 0);
+      Counts[Leaves + I] = 1;
+    }
+    for (unsigned I = Leaves - 1; I != 0; --I) {
+      Keys[I] = std::max(Keys[2 * I], Keys[2 * I + 1]);
+      Counts[I] = (Keys[2 * I] == Keys[I] ? Counts[2 * I] : 0) +
+                  (Keys[2 * I + 1] == Keys[I] ? Counts[2 * I + 1] : 0);
+    }
+    Size = N;
+    Epoch = E;
+    Valid = true;
+  }
+
+  // Queue mutation is already complete. A swap/pop changes at most two
+  // prefix positions; entries after the exact 1000-element window stay absent.
+  template <class Q, class Key>
+  void changed(const Q &Queue, unsigned Changed, size_t OldSize, uint64_t E,
+               Key K) {
+    if (!Valid || Epoch != E) {
+      invalidate();
+      return;
+    }
+    unsigned Old = std::min<size_t>(OldSize, Limit);
+    unsigned Now = std::min<size_t>(Queue.size(), Limit);
+    if (Changed < Now)
+      set(Changed, K(Queue[Changed]));
+    if (Old > Now)
+      set(Old - 1, 0);
+    if (Now > Old && Changed != Now - 1)
+      set(Now - 1, K(Queue[Now - 1]));
+    Size = Now;
+  }
+
+  unsigned winningCount() const { assert(Valid); return Counts[1]; }
+  template <class Fn> void forEachWinner(Fn F) const {
+    assert(Valid && Size);
+    visit(1, Keys[1], F);
+  }
+};
+} // namespace source_order_detail
+} // namespace llvm
+#endif
