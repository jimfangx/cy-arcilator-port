+// Definitions precede uses and Prev links are circular. Traverse only the use
+// suffix backwards, then restore its original order in the appended buffer.
+void MachineRegisterInfo::collectNonDebugUseOperands(
+    Register Reg, SmallVectorImpl<MachineOperand *> &Operands) const {
+  MachineOperand *Head = getRegUseDefListHead(Reg);
+  if (!Head)
+    return;
+  size_t Begin = Operands.size();
+  for (MachineOperand *MO = Head->Contents.Reg.Prev; MO->isUse();
+       MO = MO->Contents.Reg.Prev) {
+    if (!MO->isDebug())
+      Operands.push_back(MO);
+    if (MO == Head)
+      break;
+  }
+  std::reverse(Operands.begin() + Begin, Operands.end());
+}
