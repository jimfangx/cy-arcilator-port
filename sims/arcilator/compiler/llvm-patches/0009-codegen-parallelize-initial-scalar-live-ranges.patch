+// The scalar path of LiveIntervalCalc::calculate, with no MachineOperand
+// mutation. All caches inherited from LiveRangeCalc and all output ranges are
+// worker-owned. The caller proves there are no subregister/bundle operands.
+class ReadOnlyScalarIntervalCalc : public LiveRangeCalc {
+public:
+  void calculate(LiveInterval &LI) {
+    const MachineRegisterInfo *MRI = getRegInfo();
+    SlotIndexes *Indexes = getIndexes();
+    VNInfo::Allocator *Alloc = getVNAlloc();
+    Register Reg = LI.reg();
+    for (const MachineOperand &MO : MRI->reg_nodbg_operands(Reg)) {
+      if (MO.isDef()) {
+        SlotIndex Def = Indexes->getInstructionIndex(*MO.getParent())
+                            .getRegSlot(MO.isEarlyClobber());
+        LI.createDeadDef(Def, *Alloc);
+      }
+    }
+    resetLiveOutMap();
+    for (const MachineOperand &MO : MRI->reg_nodbg_operands(Reg)) {
+      if (!MO.readsReg())
+        continue;
+      const MachineInstr *MI = MO.getParent();
+      unsigned OpNo = &MO - &MI->getOperand(0);
+      SlotIndex Use;
+      if (MI->isPHI()) {
+        Use = Indexes->getMBBEndIdx(MI->getOperand(OpNo + 1).getMBB());
+      } else {
+        bool Early = MO.isDef() && MO.isEarlyClobber();
+        unsigned DefIdx;
+        if (!MO.isDef() && MI->isRegTiedToDefOperand(OpNo, &DefIdx))
+          Early = MI->getOperand(DefIdx).isEarlyClobber();
+        Use = Indexes->getInstructionIndex(*MI).getRegSlot(Early);
+      }
+      extend(LI, Use, Reg, {});
+    }
+  }
+};
+
+bool equalScalarRanges(const LiveInterval &A, const LiveInterval &B) {
+  if (A.hasSubRanges() || B.hasSubRanges() || A.valnos.size() != B.valnos.size()
+      || A.segments.size() != B.segments.size())
+    return false;
+  for (size_t I = 0; I != A.valnos.size(); ++I)
+    if (A.valnos[I]->id != B.valnos[I]->id ||
+        A.valnos[I]->def != B.valnos[I]->def)
+      return false;
+  for (size_t I = 0; I != A.segments.size(); ++I) {
+    const auto &X = A.segments[I], &Y = B.segments[I];
+    if (X.start != Y.start || X.end != Y.end || X.valno->id != Y.valno->id)
+      return false;
+  }
+  return true;
+}
+
+std::string snapshotMIR(const MachineFunction &MF, const SlotIndexes *Indexes) {
+  std::string Text;
+  raw_string_ostream OS(Text);
+  MF.print(OS, Indexes);
+  return Text;
+}
