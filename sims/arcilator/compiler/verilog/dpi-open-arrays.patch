+// Preserve the actual shape of an open-array call without converting it into
+// an untyped dynamic pointer. The native bridge still exposes an open handle
+// to C; native_open_actual records only its SV value transport representation.
+moore::DPIFuncOp Context::specializeOpenDPI(
+    moore::DPIFuncOp original, const slang::ast::SubroutineSymbol &subroutine,
+    ArrayRef<const slang::ast::Type *> actualTypes) {
+  auto signature = getDPISignature(*this, subroutine);
+  if (failed(signature)) return {};
+  auto imports = intoModuleOp->getAttrOfType<DictionaryAttr>("chipyard.dpi_imports");
+  auto entry = imports.getAs<DictionaryAttr>(original.getSymName());
+  SmallVector<Attribute> abi(entry.getAs<ArrayAttr>("abi").getValue());
+  bool changed = false;
+  auto compatible = [&](auto &&self, const slang::ast::Type &formal,
+                        const slang::ast::Type &actual) -> bool {
+    using namespace slang::ast;
+    const auto &f = formal.getCanonicalType(), &a = actual.getCanonicalType();
+    if (auto *open = f.as_if<DPIOpenArrayType>()) {
+      auto *fixed = a.as_if<FixedSizeUnpackedArrayType>();
+      return !open->isPacked && fixed && self(self, open->elementType, fixed->elementType);
+    }
+    if (auto *fixed = f.as_if<FixedSizeUnpackedArrayType>()) {
+      auto *other = a.as_if<FixedSizeUnpackedArrayType>();
+      return other && fixed->range.width() == other->range.width() &&
+             self(self, fixed->elementType, other->elementType);
+    }
+    return f.isMatching(a);
+  };
+  for (auto [i, arg] : llvm::enumerate(subroutine.getArguments())) {
+    if (actualTypes[i] == &arg->getType()) continue;
+    if (!compatible(compatible, arg->getType(), *actualTypes[i])) {
+      mlir::emitError(convertLocation(arg->location),
+                      "native open DPI requires compatible fixed unpacked actual dimensions");
+      return {};
+    }
+    auto type = convertType(*actualTypes[i]);
+    if (!type) return {};
+    (*signature)[i].type = type;
+    NamedAttrList info(cast<DictionaryAttr>(abi[i]));
+    info.set("native_open_actual", describeDPIType(*this, *actualTypes[i]));
+    abi[i] = info.getDictionary(getContext());
+    changed = true;
+  }
+  if (!changed) return original;
+  OpBuilder::InsertionGuard guard(builder);
+  builder.setInsertionPointAfter(original);
+  auto specialized = moore::DPIFuncOp::create(
+      builder, original.getLoc(),
+      builder.getStringAttr(original.getSymName().str() + "_open_actual"),
+      *signature, ArrayAttr{}, original->getAttrOfType<StringAttr>("verilogName"));
+  SymbolTable::setSymbolVisibility(specialized, SymbolTable::Visibility::Private);
+  symbolTable.insert(specialized);
+  NamedAttrList metadata(entry);
+  metadata.set("abi", builder.getArrayAttr(abi));
+  NamedAttrList updated(imports);
+  updated.set(specialized.getSymName(), metadata.getDictionary(getContext()));
+  intoModuleOp->setAttr("chipyard.dpi_imports", updated.getDictionary(getContext()));
+  return specialized;
+}
