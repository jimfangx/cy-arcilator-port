+static DictionaryAttr describeDPIType(Context &context,
+                                      const slang::ast::Type &original) {
+  using namespace slang::ast;
+  auto &builder = context.builder;
+  const auto &type = original.getCanonicalType();
+  // Typedefs and enums inherit the C representation of their underlying type.
+  if (auto *enumeration = type.as_if<EnumType>())
+    return describeDPIType(context, enumeration->baseType);
+  NamedAttrList info;
+  StringRef kind = "unsupported";
+  if (type.isIntegral()) {
+    info.set("width", builder.getI64IntegerAttr(type.getBitWidth()));
+    info.set("signed", builder.getBoolAttr(type.isSigned()));
+    info.set("four_state", builder.getBoolAttr(type.isFourState()));
+  }
+  if (auto *scalar = type.as_if<ScalarType>()) {
+    kind = scalar->scalarKind == ScalarType::Bit ? "bit" : "logic";
+  } else if (auto *integer = type.as_if<PredefinedIntegerType>()) {
+    switch (integer->integerKind) {
+    case PredefinedIntegerType::Byte:
+      kind = "byte";
+      break;
+    case PredefinedIntegerType::ShortInt:
+      kind = "shortint";
+      break;
+    case PredefinedIntegerType::Int:
+      kind = "int";
+      break;
+    case PredefinedIntegerType::LongInt:
+      kind = "longint";
+      break;
+    case PredefinedIntegerType::Integer:
+      kind = "integer";
+      break;
+    case PredefinedIntegerType::Time:
+      kind = "time";
+      break;
+    }
+  } else if (auto *packed = type.as_if<PackedArrayType>()) {
+    kind = "packed_array";
+    info.set("left", builder.getI64IntegerAttr(packed->range.left));
+    info.set("right", builder.getI64IntegerAttr(packed->range.right));
+    info.set("element", describeDPIType(context, packed->elementType));
+  } else if (type.kind == SymbolKind::PackedStructType) {
+    kind = "packed_struct";
+  } else if (type.kind == SymbolKind::PackedUnionType) {
+    kind = "packed_union";
+  } else if (auto *array = type.as_if<FixedSizeUnpackedArrayType>()) {
+    kind = "unpacked_array";
+    info.set("left", builder.getI64IntegerAttr(array->range.left));
+    info.set("right", builder.getI64IntegerAttr(array->range.right));
+    info.set("element", describeDPIType(context, array->elementType));
+  } else if (auto *array = type.as_if<DPIOpenArrayType>()) {
+    kind = "open_array";
+    info.set("packed", builder.getBoolAttr(array->isPacked));
+    info.set("element", describeDPIType(context, array->elementType));
+  } else if (auto *floating = type.as_if<FloatingType>()) {
+    switch (floating->floatKind) {
+    case FloatingType::ShortReal:
+      kind = "shortreal";
+      break;
+    case FloatingType::Real:
+      kind = "real";
+      break;
+    case FloatingType::RealTime:
+      kind = "realtime";
+      break;
+    }
+  } else if (type.kind == SymbolKind::StringType) {
+    kind = "string";
+  } else if (type.kind == SymbolKind::CHandleType) {
+    kind = "chandle";
+  }
+  info.set("kind", builder.getStringAttr(kind));
+  return info.getDictionary(context.getContext());
+}
