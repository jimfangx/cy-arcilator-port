+static DictionaryAttr
+describeDPIImport(Context &context,
+                  const slang::ast::SubroutineSymbol &subroutine,
+                  StringAttr cName) {
+  auto &builder = context.builder;
+  SmallVector<Attribute> abi, sourceTypes;
+  for (auto *arg : subroutine.getArguments()) {
+    NamedAttrList typeInfo(describeDPIType(context, arg->getType()));
+    StringRef direction;
+    switch (arg->direction) {
+    case slang::ast::ArgumentDirection::In:
+      direction = "in";
+      break;
+    case slang::ast::ArgumentDirection::Out:
+      direction = "out";
+      break;
+    case slang::ast::ArgumentDirection::InOut:
+      direction = "inout";
+      break;
+    case slang::ast::ArgumentDirection::Ref:
+      direction = "ref";
+      break;
+    }
+    typeInfo.set("direction", builder.getStringAttr(direction));
+    abi.push_back(typeInfo.getDictionary(context.getContext()));
+    sourceTypes.push_back(builder.getStringAttr(arg->getType().toString()));
+  }
+  if (!subroutine.getReturnType().isVoid()) {
+    NamedAttrList typeInfo(
+        describeDPIType(context, subroutine.getReturnType()));
+    typeInfo.set("direction", builder.getStringAttr("return"));
+    abi.push_back(typeInfo.getDictionary(context.getContext()));
+    sourceTypes.push_back(
+        builder.getStringAttr(subroutine.getReturnType().toString()));
+  }
+  NamedAttrList declaration;
+  declaration.set("c_name", cName);
+  declaration.set("name", builder.getStringAttr(subroutine.name));
+  declaration.set(
+      "scope",
+      builder.getStringAttr(
+          subroutine.getParentScope()->asSymbol().getHierarchicalPath()));
+  declaration.set("context", builder.getBoolAttr(subroutine.flags.has(
+                                 slang::ast::MethodFlags::DPIContext)));
+  declaration.set("pure", builder.getBoolAttr(subroutine.flags.has(
+                              slang::ast::MethodFlags::Pure)));
+  declaration.set("task",
+                  builder.getBoolAttr(subroutine.subroutineKind ==
+                                      slang::ast::SubroutineKind::Task));
+  declaration.set("source_types", builder.getArrayAttr(sourceTypes));
+  auto timeScale = subroutine.getTimeScale().value_or(context.timeScale);
+  auto inFS = [](slang::TimeScaleValue value) {
+    uint64_t result = static_cast<uint64_t>(value.magnitude);
+    for (unsigned unit = static_cast<unsigned>(value.unit); unit < 5; ++unit)
+      result *= 1000;
+    return result;
+  };
+  declaration.set("timeunit_fs",
+                  builder.getI64IntegerAttr(inFS(timeScale.base)));
+  declaration.set("timeprecision_fs",
+                  builder.getI64IntegerAttr(inFS(timeScale.precision)));
+  NamedAttrList result;
+  result.set("version", builder.getI32IntegerAttr(1));
+  result.set("abi", builder.getArrayAttr(abi));
+  result.set("declaration", declaration.getDictionary(context.getContext()));
+  return result.getDictionary(context.getContext());
+}
