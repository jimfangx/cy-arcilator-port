 /// Parse and elaborate the prepared source files, and populate the given MLIR
 /// `module` with corresponding operations.
+// Detailed source facts for one elaborated Slang compilation. This does not
+// infer a whole native model's timebase from independently imported wrappers.
+extern "C" const char *chipyard_arc_vpi_metadata_path() __attribute__((weak));
+namespace {
+class MetadataStreamBuffer : public std::streambuf {
+  llvm::raw_ostream &output;
+  std::streamsize xsputn(const char *s, std::streamsize count) override {
+    output.write(s, size_t(count));
+    return count;
+  }
+  int_type overflow(int_type value) override {
+    if (!traits_type::eq_int_type(value, traits_type::eof()))
+      output << traits_type::to_char_type(value);
+    return traits_type::not_eof(value);
+  }
+public:
+  explicit MetadataStreamBuffer(llvm::raw_ostream &output) : output(output) {}
+};
+
+LogicalResult emitNativeVpiMetadata(ModuleOp module,
+                                    slang::ast::Compilation &compilation,
+                                    const ImportVerilogOptions &options) {
+  if (!chipyard_arc_vpi_metadata_path)
+    return success();
+  const char *filename = chipyard_arc_vpi_metadata_path();
+  if (!filename || !*filename)
+    return success();
+  int fd;
+  SmallString<256> temporary;
+  auto error = llvm::sys::fs::createUniqueFile(
+      Twine(filename) + ".tmp-%%%%%%", fd, temporary);
+  if (error)
+    return module.emitError("cannot create native VPI source metadata: ")
+           << error.message();
+  llvm::ToolOutputFile file(temporary, fd);
+  MetadataStreamBuffer buffer(file.os());
+  std::ostream output(&buffer);
+  slang::JsonWriter writer;
+  writer.setPrettyPrint(true);
+  slang::ast::ASTSerializer serializer(compilation, writer);
+  serializer.setIncludeAddresses(true);
+  serializer.setIncludeSourceInfo(true);
+  serializer.setDetailedTypeInfo(true);
+  // Observation must not evaluate otherwise unused source expressions.
+  serializer.setTryConstantFold(false);
+  serializer.startObject();
+  serializer.write("schema", std::string_view("chipyard.arcilator.sv-source"));
+  serializer.write("version", int64_t(1));
+  serializer.write("slang_version", circt::getSlangVersion());
+  serializer.write("scope", std::string_view("one-elaborated-compilation"));
+  serializer.write("symbol_identity", std::string_view("snapshot-local-slang-address"));
+  serializer.write("mode", options.mode == ImportVerilogOptions::Mode::OnlyLint
+                               ? std::string_view("lint")
+                               : std::string_view("import"));
+  serializer.startArray("time_scales");
+  auto units = compilation.getCompilationUnits();
+  auto addScale = [&](const slang::ast::Symbol &symbol, std::string_view kind,
+                      std::optional<slang::TimeScale> resolved) {
+    int64_t unit = -1;
+    std::string library;
+    for (auto *parent = &symbol; parent;) {
+      if (auto *scope = parent->as_if<slang::ast::CompilationUnitSymbol>()) {
+        library = scope->sourceLibrary.name;
+        for (auto [index, candidate] : llvm::enumerate(units))
+          if (scope == candidate) unit = index;
+        break;
+      }
+      auto *scope = parent->getParentScope();
+      parent = scope ? &scope->asSymbol() : nullptr;
+    }
+    if (auto *definition = symbol.as_if<slang::ast::DefinitionSymbol>())
+      library = definition->sourceLibrary.name;
+    auto inFS = [](slang::TimeScaleValue value) {
+      uint64_t result = static_cast<uint64_t>(value.magnitude);
+      for (unsigned unit = static_cast<unsigned>(value.unit); unit < 5; ++unit)
+        result *= 1000;
+      return result;
+    };
+    auto scale = resolved.value_or(slang::TimeScale());
+    serializer.startObject();
+    serializer.write("kind", kind);
+    serializer.write("name", symbol.getHierarchicalPath());
+    serializer.write("compilation_unit", unit);
+    serializer.write("source_library", library);
+    serializer.write("timeunit_fs", inFS(scale.base));
+    serializer.write("timeprecision_fs", inFS(scale.precision));
+    serializer.write("resolved", resolved.has_value());
+    if (symbol.location && compilation.getSourceManager()) {
+      auto &manager = *compilation.getSourceManager();
+      serializer.write("source_file", manager.getFileName(symbol.location));
+      serializer.write("source_line", manager.getLineNumber(symbol.location));
+    }
+    serializer.endObject();
+  };
+  for (auto *unit : units)
+    addScale(*unit, "compilation_unit", unit->getTimeScale());
+  for (auto *package : compilation.getPackages())
+    if (package->getSyntax())
+      addScale(*package, "package", package->getTimeScale());
+  for (auto *symbol : compilation.getDefinitions())
+    if (auto *definition = symbol->as_if<slang::ast::DefinitionSymbol>())
+      addScale(*definition, definition->getKindString(), definition->timeScale);
+  serializer.endArray();
+  serializer.writeProperty("design");
+  serializer.serialize(compilation.getRoot());
+  writer.flushTo(output);
+  serializer.startArray("definitions");
+  for (auto *definition : compilation.getDefinitions()) {
+    serializer.serialize(*definition);
+    writer.flushTo(output);
+  }
+  serializer.endArray();
+  serializer.endObject();
+  writer.writeNewLine();
+  writer.flushTo(output);
+  output.flush();
+  file.os().flush();
+  if (file.os().has_error()) {
+    auto error = file.os().error();
+    file.os().clear_error();
+    return module.emitError("cannot write native VPI source metadata: ")
+           << error.message();
+  }
+  if (auto error = llvm::sys::fs::rename(temporary, filename))
+    return module.emitError("cannot publish native VPI source metadata: ")
+           << error.message();
+  file.keep();
+  return success();
+}
