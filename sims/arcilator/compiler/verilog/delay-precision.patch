+Value Context::convertDelayExpression(const slang::ast::Expression &expr) {
+  auto loc = convertLocation(expr.sourceRange);
+  auto value = convertRvalueExpression(expr);
+  if (!value)
+    return {};
+  auto timeType = moore::TimeType::get(getContext());
+  if (!isa<moore::RealType>(value.getType()))
+    return materializeConversion(timeType, value, expr.type->isSigned(), loc);
+
+  auto inFS = [](slang::TimeScaleValue scale) {
+    auto result = static_cast<uint64_t>(scale.magnitude);
+    for (unsigned unit = static_cast<unsigned>(scale.unit); unit < 5; ++unit)
+      result *= 1000;
+    return result;
+  };
+  uint64_t precision = inFS(timeScale.precision);
+  uint64_t scale = getTimeScaleInFemtoseconds(*this) / precision;
+  auto realType = moore::RealType::get(getContext(), moore::RealWidth::f64);
+  value = materializeConversion(realType, value, false, loc);
+  auto factor = moore::ConstantRealOp::create(
+      builder, loc, realType, builder.getF64FloatAttr(scale));
+  auto scaled = builder.createOrFold<moore::MulRealOp>(loc, value, factor);
+  auto integer = moore::IntType::get(getContext(), 64, Domain::TwoValued);
+  Value ticks = builder.createOrFold<moore::RealToIntOp>(loc, integer, scaled);
+  if (precision != 1) {
+    auto tickFS = moore::ConstantOp::create(builder, loc, integer, precision);
+    ticks = builder.createOrFold<moore::MulOp>(loc, ticks, tickFS);
+  }
+  auto logic = moore::IntToLogicOp::create(builder, loc, ticks);
+  return moore::LogicToTimeOp::create(builder, loc, logic);
 }
 
