 namespace {
+// Static procedural declarations belong to the enclosing instance (or package),
+// even when a function is automatic. Allocate them before lowering any body so
+// calls share storage and the local-variable SSA pass cannot erase their state.
+struct StaticLocalCollector
+    : public slang::ast::ASTVisitor<StaticLocalCollector,
+                                    slang::ast::VisitFlags::AllCanonical> {
+  const slang::ast::Symbol &owner;
+  llvm::SmallSetVector<const slang::ast::VariableSymbol *, 16> variables;
+  explicit StaticLocalCollector(const slang::ast::Symbol &owner)
+      : owner(owner) {}
+  void handle(const slang::ast::InstanceBodySymbol &body) {
+    if (&body == &owner)
+      visitDefault(body);
+  }
+  void handle(const slang::ast::ClassType &) {}
+  void handle(const slang::ast::SubroutineSymbol &fn) {
+    if (fn.flags.has(slang::ast::MethodFlags::DPIImport))
+      return;
+    visitDefault(fn);
+  }
+  void handle(const slang::ast::VariableDeclStatement &stmt) {
+    if (stmt.symbol.lifetime == slang::ast::VariableLifetime::Static)
+      variables.insert(&stmt.symbol);
+    visitDefault(stmt);
+  }
+};
+static LogicalResult declareStaticLocals(Context &context,
+                                         const slang::ast::Symbol &scope,
+                                         bool global = false) {
+  StaticLocalCollector collector(scope);
+  scope.visit(collector);
+  auto &b = context.builder;
+  // Initialize only fresh declarations: generated scopes can be visited again.
+  SmallVector<const slang::ast::VariableSymbol *> declared;
+  for (auto *var : collector.variables) {
+    if (global) {
+      if (!context.globalVariables.lookup(var) &&
+          failed(context.convertGlobalVariable(*var)))
+        return failure();
+      context.globalVariables.lookup(var).setPrivate();
+      continue;
+    }
+    if (context.valueSymbols.lookup(var))
+      continue;
+    auto ty = context.convertType(var->getType());
+    if (!ty)
+      return failure();
+    auto op = moore::VariableOp::create(
+        b, context.convertLocation(var->location),
+        moore::RefType::get(cast<moore::UnpackedType>(ty)),
+        b.getStringAttr(var->getHierarchicalPath()), Value{});
+    context.valueSymbols.insert(var, op);
+    declared.push_back(var);
+  }
+  if (!global)
+    for (auto *var : declared) {
+      if (auto *init = var->getInitializer()) {
+        auto ref = context.valueSymbols.lookup(var);
+        auto value = context.convertRvalueExpression(
+            *init, cast<moore::RefType>(ref.getType()).getNestedType());
+        if (!value)
+          return failure();
+        ref.getDefiningOp<moore::VariableOp>().getInitialMutable().assign(
+            value);
+      }
+    }
+  return success();
+}
