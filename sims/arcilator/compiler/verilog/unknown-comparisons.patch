+static std::optional<FVInt> caseConstant(Value value) {
+  auto *op = value.getDefiningOp();
+  if (!op)
+    return std::nullopt;
+  if (auto constant = dyn_cast<moore::ConstantOp>(op))
+    return constant.getValue();
+  if (isa<moore::PackedToSBVOp, moore::SBVToPackedOp, moore::IntToLogicOp,
+          moore::ToBuiltinIntOp, moore::FromBuiltinIntOp>(op))
+    return caseConstant(op->getOperand(0));
+  if (isa<moore::LogicToIntOp>(op)) {
+    if (auto source = caseConstant(op->getOperand(0)))
+      return FVInt(source->toAPInt(false));
+    return std::nullopt;
+  }
+  if (isa<moore::ConcatOp>(op)) {
+    std::optional<FVInt> result;
+    for (auto operand : op->getOperands()) {
+      auto part = caseConstant(operand);
+      if (!part)
+        return std::nullopt;
+      if (!result)
+        result = *part;
+      else
+        result = FVInt(result->getRawValue().concat(part->getRawValue()),
+                       result->getRawUnknown().concat(part->getRawUnknown()));
+    }
+    return result;
+  }
+  if (isa<moore::ReplicateOp>(op)) {
+    auto source = caseConstant(op->getOperand(0));
+    auto width = cast<moore::IntType>(value.getType()).getWidth();
+    if (!source || !source->getBitWidth() || width % source->getBitWidth())
+      return std::nullopt;
+    return FVInt(llvm::APInt::getSplat(width, source->getRawValue()),
+                 llvm::APInt::getSplat(width, source->getRawUnknown()));
+  }
+  if (isa<moore::ZExtOp, moore::SExtOp, moore::TruncOp>(op)) {
+    auto source = caseConstant(op->getOperand(0));
+    if (!source)
+      return std::nullopt;
+    auto width = cast<moore::IntType>(value.getType()).getWidth();
+    return isa<moore::SExtOp>(op) ? source->sextOrTrunc(width)
+                                  : source->zextOrTrunc(width);
+  }
+  return std::nullopt;
+}
