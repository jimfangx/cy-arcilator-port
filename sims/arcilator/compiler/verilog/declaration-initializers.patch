+namespace {
+// A dead declaration can lose its VariableOp during canonicalization while its
+// effectful DPI initializer survives. Remember that execution belongs to static
+// initialization before either Moore or LLHD cleanup removes the storage.
+struct RememberDeclarationDPI
+    : PassWrapper<RememberDeclarationDPI, OperationPass<ModuleOp>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(RememberDeclarationDPI)
+  void runOnOperation() override {
+    getOperation().walk([&](moore::VariableOp variable) {
+      if (!isa<moore::SVModuleOp>(variable->getParentOp()) ||
+          !variable.getInitial())
+        return;
+      SmallVector<Value> pending{variable.getInitial()};
+      DenseSet<Operation *> seen;
+      while (!pending.empty()) {
+        auto *op = pending.pop_back_val().getDefiningOp();
+        if (!op || op->getBlock() != variable->getBlock() ||
+            isa<moore::VariableOp>(op) || !seen.insert(op).second)
+          continue;
+        if (isa<moore::FuncDPICallOp>(op))
+          op->setAttr("chipyard.declaration_initializer",
+                      UnitAttr::get(&getContext()));
+        pending.append(op->operand_begin(), op->operand_end());
+      }
+    });
+  }
+};
+} // namespace
+
