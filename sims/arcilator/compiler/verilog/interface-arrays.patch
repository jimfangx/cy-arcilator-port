 //===----------------------------------------------------------------------===//
 // Utilities
 //===----------------------------------------------------------------------===//
+
+/// Enumerate interface array leaves in Slang's connection order. Slang has
+/// already rebased and reversed dimensions to match the receiving port.
+static void collectInterfaceInstances(
+    const slang::ast::Symbol *symbol,
+    SmallVectorImpl<const slang::ast::InstanceSymbol *> &instances) {
+  if (!symbol)
+    return;
+  if (auto *instance = symbol->as_if<slang::ast::InstanceSymbol>()) {
+    instances.push_back(instance);
+  } else if (auto *array = symbol->as_if<slang::ast::InstanceArraySymbol>()) {
+    for (auto *element : array->elements)
+      collectInterfaceInstances(element, instances);
+  }
+}
 
