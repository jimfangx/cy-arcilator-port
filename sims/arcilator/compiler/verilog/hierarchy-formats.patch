+namespace {
+/// Slang permits system tasks in constant-function evaluation and discards
+/// their effects. Runtime folding must retain those calls, including calls
+/// reached through another function or an enclosing constant expression.
+struct RuntimeTaskScanner
+    : slang::ast::ASTVisitor<RuntimeTaskScanner,
+                             slang::ast::VisitFlags::AllGood> {
+  llvm::SmallPtrSet<const slang::ast::SubroutineSymbol *, 8> visited;
+  bool found = false;
+
+  void handle(const slang::ast::CallExpression &call) {
+    if (found)
+      return;
+    call.visitExprsNoArgs(*this);
+    if (call.isSystemCall()) {
+      const auto &system = *std::get<1>(call.subroutine).subroutine;
+      if (system.kind == slang::ast::SubroutineKind::Task) {
+        found = true;
+        return;
+      }
+      // Type queries such as $bits do not execute their argument expressions.
+      for (auto [index, arg] : llvm::enumerate(call.arguments()))
+        if (!system.isArgUnevaluated(index))
+          arg->visit(*this);
+      return;
+    }
+    for (auto *arg : call.arguments())
+      arg->visit(*this);
+    const auto *subroutine = std::get<0>(call.subroutine);
+    if (!found && !subroutine->flags.has(slang::ast::MethodFlags::DPIImport) &&
+        visited.insert(subroutine).second)
+      subroutine->getBody().visit(*this);
+  }
+};
+} // namespace
