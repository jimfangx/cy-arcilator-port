+// Fixed-size array assignments preserve element positions while reshaping
+// assignment-compatible packed elements. Keep this separate from width-changing
+// element conversions: Moore integers do not retain the element signedness.
+static bool isPackedArrayReshape(Type source, Type destination) {
+  if (source == destination)
+    return true;
+  auto srcArray = dyn_cast<moore::UnpackedArrayType>(source);
+  auto dstArray = dyn_cast<moore::UnpackedArrayType>(destination);
+  if (srcArray || dstArray)
+    return srcArray && dstArray && srcArray.getSize() == dstArray.getSize() &&
+           isPackedArrayReshape(srcArray.getElementType(),
+                                dstArray.getElementType());
+  auto srcPacked = dyn_cast<moore::PackedType>(source);
+  auto dstPacked = dyn_cast<moore::PackedType>(destination);
+  if (!srcPacked || !dstPacked || srcPacked.containsTimeType() ||
+      dstPacked.containsTimeType())
+    return false;
+  auto srcBits = srcPacked.getSimpleBitVector();
+  auto dstBits = dstPacked.getSimpleBitVector();
+  return srcBits && dstBits && srcBits.getWidth() == dstBits.getWidth();
+}
