// SimBlockDevice.v's original interface, with four hardware tags.
module {
  hw.module.extern private @SimBlockDevice<TAG_BITS: ui32 = 1>(in %clock : !seq.clock, in %reset : i1, in %bdev_req_valid : i1, out bdev_req_ready : i1, in %bdev_req_bits_write : i1, in %bdev_req_bits_offset : i32, in %bdev_req_bits_len : i32, in %bdev_req_bits_tag : i2, in %bdev_data_valid : i1, out bdev_data_ready : i1, in %bdev_data_bits_data : i64, in %bdev_data_bits_tag : i2, out bdev_resp_valid : i1, in %bdev_resp_ready : i1, out bdev_resp_bits_data : i64, out bdev_resp_bits_tag : i2, out bdev_info_nsectors : i32, out bdev_info_max_req_len : i32)
  hw.module @BlockDeviceModelProbe(in %clock : i1, in %reset : i1, in %bdev_req_valid : i1, in %bdev_req_bits_write : i1, in %bdev_req_bits_offset : i32, in %bdev_req_bits_len : i32, in %bdev_req_bits_tag : i2, in %bdev_data_valid : i1, in %bdev_data_bits_data : i64, in %bdev_data_bits_tag : i2, in %bdev_resp_ready : i1, out bdev_req_ready : i1, out bdev_data_ready : i1, out bdev_resp_valid : i1, out bdev_resp_bits_data : i64, out bdev_resp_bits_tag : i2, out bdev_info_nsectors : i32, out bdev_info_max_req_len : i32) {
    %clk = seq.to_clock %clock
    %req_ready, %data_ready, %resp_valid, %resp_data, %resp_tag, %sectors, %max_len = hw.instance "disk" @SimBlockDevice<TAG_BITS: ui32 = 2>(clock: %clk: !seq.clock, reset: %reset: i1, bdev_req_valid: %bdev_req_valid: i1, bdev_req_bits_write: %bdev_req_bits_write: i1, bdev_req_bits_offset: %bdev_req_bits_offset: i32, bdev_req_bits_len: %bdev_req_bits_len: i32, bdev_req_bits_tag: %bdev_req_bits_tag: i2, bdev_data_valid: %bdev_data_valid: i1, bdev_data_bits_data: %bdev_data_bits_data: i64, bdev_data_bits_tag: %bdev_data_bits_tag: i2, bdev_resp_ready: %bdev_resp_ready: i1) -> (bdev_req_ready: i1, bdev_data_ready: i1, bdev_resp_valid: i1, bdev_resp_bits_data: i64, bdev_resp_bits_tag: i2, bdev_info_nsectors: i32, bdev_info_max_req_len: i32)
    hw.output %req_ready, %data_ready, %resp_valid, %resp_data, %resp_tag, %sectors, %max_len : i1, i1, i1, i64, i2, i32, i32
  }
}
